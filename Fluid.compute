// The experimental isosurface kernel is deliberately not compiled in the
// stable build.  Its prototype remains below for later work, but cannot make
// an otherwise healthy fluid compute shader report an invalid kernel.

struct GPUParticle
{
    float3 pos;
    float3 vel;
    float invMass;
    float density;
    int state;
    float sleepTimer;
    float2 padding;
};

struct TileData
{
    float3 worldPos;
    float height;
    int active;
    float3 pad;
};

struct BulkWaterCell
{
    float surfaceY;
    float sphBottomY;
    float supportY;
    float volume;
    int activeCount;
    int bulkCount;
    int spawnedThisStep;
    int absorbedThisStep;
    int activeBandCount;
    int lowerBandCount;
    // Accumulated conversion credit in 1/1000 particle-token units. This is
    // persistent state, so support rise is rate-limited without inventing
    // volume when a cell has no eligible settled cohort.
    int absorptionCreditMilliTokens;
};

struct BulkVoxelCell
{
    float fill;
    float density;
    float pressure;
    int tokenCount;
    int flags;
};

// The clean hybrid path: this 3D field owns water volume and momentum. PBF
// particles are a bounded skin sampled from its exposed columns, never a
// second mass store.
struct PrimaryVoxelCell
{
    float4 velocityPressure; // xyz velocity, w pressure
    float4 fillAndFlags;     // x fill, y flags (reserved), zw spare
};

struct PrimaryVoxelInflow
{
    float4 positionVolume;   // xyz world position, w volume this step
    float4 velocityEnabled;  // xyz jet direction/max speed, w: 1 spawn, 2 breach
    float4 reservoirHole;    // x external sea level, y width, z height, w discharge coefficient
};

struct PrimaryVoxelHatchProbe
{
    float4 positionAndAmount;
    float4 timingAndStatus;
};

struct PrimaryVoxelFaceFlux
{
    float4 lateral; // +X, -X, +Z, -Z outgoing fill
    float2 vertical; // -Y, +Y outgoing fill
    float2 padding;
};


// Render/kinematic long-wave state. eta is a zero-volume perturbation around
// the authoritative voxel base surface; q is depth-integrated discharge.
struct SurfaceWaveCell
{
    float4 etaBaseDepthPrevious; // x eta, y voxel base Y, z H, w previous base Y
    // xy are current/previous explicit hatch-link impulses; z is the
    // contact voxel layer and w marks a valid exposed surface entry.
    float4 momentumContactFlags;
};

struct SurfaceWaveFaceFlux
{
    float2 discharge; // persistent +X/+Z depth-integrated face momentum
    float2 primaryFluxPrevious; // prior voxel face-force signal for delta forcing
    float2 connectivity; // current +X/+Z face openness, for basin diagnostics
    float2 wallImpact; // signed +X/+Z discharge stopped by a wall this solve
};

struct SurfaceWaveFlickerEvent
{
    float4 identity;
    float4 state;
    float4 baseAndFill;
    float4 eta;
    float4 correction;
    float4 pressureFlux;
    float4 columnHatch;
    float4 discharge;
    float4 finalHeight;
    float4 flags;
};
// High-resolution, per-deck visual surface transport. It does not own height
// or mass: the base velocity always comes from the voxel/wave layers.
struct SurfaceFlowCell
{
    float4 residualDyeFoamAge; // xy residual m/s, z debug dye/foam, w age
    float4 baseVelocityWetSignal; // xy physical base m/s, z wet, w event signal
};
struct PrimaryVoxelHatchDebug
{
    float4 lower;  // fill, solid, valid, centre Y
    float4 throat; // blocked, upward flux, downward flux, face Y
    float4 upper;  // fill, solid, valid, centre Y
    float4 coord;  // X, lower Y, Z, upper Y
};

// Cosmetic detached droplets.  Spray is deliberately not part of the PBF
// particle or bulk-token buffers: it has a bounded lifetime and never feeds
// back into density or mass accounting.
struct SprayParticle
{
    float3 position;
    float life;
    float3 velocity;
    float radius;
};

// Purely visual: a soft painterly mark representing moving water, not a
// simulated particle. positionType.w is 1 for an exposed surface accent.
struct CurrentSplat
{
    float4 positionType;
    float4 velocityRadius;
};

// One render-only history record per stable PBF support slot. This keeps the
// painted shell smooth without altering particle, voxel, or mass state.
struct SurfaceGaussianHistory
{
    float4 positionAndValid;
    float4 velocity;
};

// Independent visual tracer state for the sparse underwater accents. This is
// intentionally separate from fluid particles and voxel mass.
struct UnderwaterSplatState
{
    float4 positionAndAlive;
    float4 velocityAndSeed;
};

// Display-only 2x microvoxel field. The coarse bulk/PBF field remains the
// mass authority; these cells carry the higher-resolution visual density,
// pressure, surface clipping and PBF/bulk contribution blend.
struct MicroVoxelCell
{
    uint particleTokens;
    uint bulkTokens;
    float fill;
    float density;
    float pressure;
    float surfaceFraction;
    float pbfWeight;
    uint flags;
};

// Render-only triangle stream for the connected liquid isosurface.  This is
// intentionally separate from the PBF particles and conserved bulk tokens.
struct MicroIsoVertex
{
    float3 position;
    float3 normal;
};

struct SolidColliderData
{
    float4 center;
    float4 halfExtents;
    float4 axisX;
    float4 axisY;
    float4 axisZ;
};

