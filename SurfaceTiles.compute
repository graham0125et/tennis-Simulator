struct GPUParticle
{
    float3 pos;
    float3 vel;
    float invMass;
    float density;
    int state;
    float sleepTimer;
    float2 padding;
};

struct TileData
{
    float3 worldPos;
    float height;
    int active;
    float3 pad;
    // pad.x = local water bottom Y for main-body sidewalls
    // pad.y = floor particle count
    // pad.z = max body particle height (raw, unscaled)
};

struct SurfaceFieldData
{
    float height;
    float coverage;
    float2 flow;
    float thickness;
    float confidence;
    float2 pad;
};

struct BulkWaterCell
{
    float surfaceY;
    float sphBottomY;
    float supportY;
    float volume;
    int activeCount;
    int bulkCount;
    int spawnedThisStep;
    int absorbedThisStep;
    int activeBandCount;
    int lowerBandCount;
    int absorptionCreditMilliTokens;
};

// Matches Fluid.compute's authoritative primary-volume cell layout.
struct PrimaryVoxelCell
{
    float4 velocityPressure;
    float4 fillAndFlags;
};

struct SurfaceVisualBaseDiagnostic
{
    float4 baseHeights;
    float4 steps;
};

struct SurfaceWaveCell{
    float4 etaBaseDepthPrevious;
    float4 momentumContactFlags;
};

struct PrimaryVoxelFaceFlux
{
    float4 lateral;
    float2 vertical;
    float2 padding;
};

struct DoorwaySurfaceDiagnosticData
{
    float4 meta;
    float4 targetCoverage;
    float4 outputCoverage;
    float4 heights;
    float4 wave;
    float4 topology;
    float4 identity;
    float4 frameIdentity;
    float4 footprintCounts;
    float4 donorAnyCoverage;
    float4 donorCompatibleCoverage;
    float4 donorPreferredCoverage;
    float4 nearestVisibleCurrent;
    float4 nearestVisiblePrevious;
};

struct DoorwaySurfaceGapScanData
{
    float4 meta;
    float4 target;
    float4 ownCoverage;
    float4 currentNeighbours;
    float4 previousNeighbours;
    float4 topology;
};

struct DoorwaySurfaceFaceData
{
    float4 meta;
    float4 sourceSurface;
    float4 targetSurface;
    float4 heights;
    float4 coverage;
    float4 flow;
    float4 state;
    float4 topology;
};

